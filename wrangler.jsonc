{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waveos",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "waveos.dreamwavemedia.co",
      "custom_domain": true
    }
  ],
  "keep_vars": true
}
